  </data>
  <data name="help_step_2" xml:space="preserve">
    <value>Select the history you want to export.</value>
  </data>
  <data name="help_step_3" xml:space="preserve">
    <value>Choose whether to protect the .hlz file with a password, then export it.</value>
  </data>
  <data name="help_step_4" xml:space="preserve">
