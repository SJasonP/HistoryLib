<Page x:Class="HistoryLib.Windows.Views.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="SearchBox" TextChanged="Search_Changed"/><ListView x:Name="List"><ListView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Grid.Column="0" Source="{Binding FaviconPath}" Width="20" Height="20"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Url}" Opacity="0.7" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VisitedAt}" Opacity="0.55"/></StackPanel><Button Grid.Column="2" Content="打开" Click="Open_Click" Tag="{Binding}"/><Button Grid.Column="3" Content="删除" Click="Delete_Click" Tag="{Binding}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Page>


