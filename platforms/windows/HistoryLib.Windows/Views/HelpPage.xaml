<Page x:Class="HistoryLib.Windows.Views.HelpPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel MaxWidth="820" HorizontalAlignment="Center" Spacing="24" Padding="8,10,8,32">
      <StackPanel Spacing="6">
        <TextBlock Text="帮助" FontSize="38" FontWeight="SemiBold"/>
        <TextBlock Text="把浏览器历史安全地带入 HistoryLib" Opacity="0.65" FontSize="15"/>
      </StackPanel>
      <Expander Header="想要更多浏览器？" IsExpanded="True">
        <StackPanel Spacing="14" Padding="0,12,0,0">
          <TextBlock Text="HistoryLib Helper 是一个本地工具，用于读取支持的浏览器历史并导出 .hlz 文件。它只读浏览器数据库，不上传历史数据。" TextWrapping="Wrap" Opacity="0.76"/>
          <TextBlock Text="支持 Google Chrome、Microsoft Edge、Brave、Vivaldi、Opera、Chromium 和 Firefox。" TextWrapping="Wrap"/>
          <TextBlock Text="1  下载并打开 HistoryLib Helper。&#x0a;2  选择要导出的历史记录。&#x0a;3  可选择密码保护，然后导出 .hlz 文件。&#x0a;4  回到 Manage，选择导入文件并打开 .hlz。" TextWrapping="Wrap"/>
          <HyperlinkButton Content="下载 HistoryLib Helper" NavigateUri="https://prods.notion.site/history-lib-helper" HorizontalAlignment="Left"/>
        </StackPanel>
      </Expander>
      <Expander Header="想要锁定此应用？">
        <StackPanel Spacing="14" Padding="0,12,0,0">
          <TextBlock Text="Windows：HistoryLib 默认启用应用隐私锁，启动时要求 Windows Hello、PIN 或指纹验证。" TextWrapping="Wrap"/>
          <TextBlock Text="可在设置中关闭“启动时要求认证”。关闭后，HistoryLib 不再在启动时请求验证。" TextWrapping="Wrap"/>
          <TextBlock Text="iOS 和 iPadOS 使用 Apple 的系统应用锁；Android 使用设备或厂商的应用锁或 Private Space。HistoryLib 不会在这些平台另行提供第二套应用锁。" TextWrapping="Wrap"/>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Page>
