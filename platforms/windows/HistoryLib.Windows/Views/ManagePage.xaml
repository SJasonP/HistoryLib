<Page x:Class="HistoryLib.Windows.Views.ManagePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="880" HorizontalAlignment="Center" Spacing="28" Padding="8,10,8,32">
      <StackPanel Spacing="6"><TextBlock x:Name="Title" FontSize="38" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Opacity="0.65" FontSize="15"/></StackPanel>
      <StackPanel Spacing="10"><TextBlock x:Name="ImportHeading" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"/><Border CornerRadius="18" Padding="24" Background="#12000000"><StackPanel Spacing="14"><TextBlock x:Name="ImportDescription" TextWrapping="Wrap" Opacity="0.72"/><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ImportButton" Click="Import_Click" Padding="18,10"/><Button x:Name="ImportFolderButton" Click="ImportFolder_Click" Padding="18,10"/></StackPanel><TextBlock x:Name="Status" TextWrapping="Wrap" Opacity="0.78"/></StackPanel></Border></StackPanel>
      <StackPanel Spacing="10"><TextBlock x:Name="ExportHeading" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"/><Border CornerRadius="18" Padding="24" Background="#12000000"><StackPanel Spacing="16"><ComboBox x:Name="ExportFormat" Header="格式" SelectedIndex="0" SelectionChanged="ExportFormat_Changed"><ComboBoxItem Content="HistoryLib (.hlz)"/><ComboBoxItem Content="Safari JSON"/></ComboBox><TextBlock x:Name="ExportDescription" TextWrapping="Wrap" Opacity="0.72"/><PasswordBox x:Name="ExportPassword" Header="密码（可选）" PlaceholderText="留空导出未加密归档"/><PasswordBox x:Name="ExportPasswordConfirm" Header="确认密码" Visibility="Collapsed"/><Button x:Name="ExportButton" Click="Export_Click" HorizontalAlignment="Left" Padding="18,10"/></StackPanel></Border></StackPanel>
      <StackPanel Spacing="10"><TextBlock x:Name="DataHeading" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"/><Border CornerRadius="18" Padding="24" Background="#12000000"><StackPanel Spacing="2"><CheckBox x:Name="IconsToggle" Click="IconsToggle_Click"/><Button x:Name="ClearCacheButton" Click="ClearCache_Click" HorizontalAlignment="Left" Padding="0,12"/><Button x:Name="ClearButton" Click="Clear_Click" HorizontalAlignment="Left" Padding="0,12"/></StackPanel></Border></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10"><Button x:Name="SettingsButton" Click="Settings_Click" Padding="18,10"/><Button x:Name="HelpButton" Click="Help_Click" Padding="18,10"/></StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>


