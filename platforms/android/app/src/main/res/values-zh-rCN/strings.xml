    <string name="manage_help">帮助</string>
    <string name="manage_help_body">可导入 Safari 历史记录、Google Takeout Chrome 历史记录或 HistoryLib .hlz 归档。导出是用户主动发起的数据转移，不是备份。获取网站图标可能向目标服务器暴露访问过的域名。</string>
    <string name="manage_back">返回</string>
    <string name="help_helper_title">HistoryLib Helper</string>
    <string name="help_helper_tagline">将浏览器历史记录导入 HistoryLib。</string>
    <string name="help_helper_description">HistoryLib Helper 是一款独立且仅在本机运行的 Windows 和 macOS 工具。它可以读取受支持浏览器的历史记录，并导出可由 HistoryLib 导入的 .hlz 文件。</string>
    <string name="help_supported_browsers_title">支持的浏览器</string>
    <string name="help_supported_browsers_body">支持 Google Chrome、Microsoft Edge、Brave、Vivaldi、Opera、Chromium 和 Firefox。</string>
    <string name="help_import_options_title">导入方式</string>
    <string name="help_import_options_body_1">HistoryLib 本体仅支持直接导入 Safari 历史记录、Google Takeout 导出文件和 .hlz 归档。</string>
    <string name="help_import_options_body_2">如果要导入电脑上的历史记录或支持更多浏览器，请使用 HistoryLib Helper 创建 .hlz 归档，然后将其导入 HistoryLib。</string>
    <string name="help_how_it_works_title">使用方法</string>
    <string name="help_step_1">在电脑上下载并打开 HistoryLib Helper。</string>
    <string name="help_step_2">选择要导出的历史记录。</string>
    <string name="help_step_3">选择是否使用密码保护 .hlz 文件，然后将其导出。</string>
    <string name="help_step_4">将 .hlz 文件传输到此设备，然后在“管理”中导入。</string>
    <string name="help_privacy_title">隐私</string>
    <string name="help_privacy_body">Helper 仅在本机运行，以只读方式打开浏览器历史记录数据库，并且不会上传您的历史记录。</string>
