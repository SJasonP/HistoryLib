    <string name="manage_help">Ayuda</string>
    <string name="manage_help_body">Importe el historial de Safari, el historial de Google Takeout Chrome o archivos .hlz de HistoryLib. La exportación es una transferencia de datos iniciada por el usuario, no una copia de seguridad. Los íconos del sitio pueden revelar los dominios visitados a sus servidores.</string>
    <string name="manage_back">Atrás</string>
    <string name="help_helper_title">Ayudante de HistoryLib</string>
    <string name="help_helper_tagline">Traiga el historial del navegador a HistoryLib.</string>
    <string name="help_helper_description">HistoryLib Helper es una herramienta local independiente para Windows y macOS. Lee el historial del navegador compatible y exporta un archivo .hlz que HistoryLib puede importar.</string>
    <string name="help_supported_browsers_title">Navegadores compatibles</string>
    <string name="help_supported_browsers_body">Se admiten Google Chrome, Microsoft Edge, Brave, Vivaldi, Opera, Chromium y Firefox.</string>
    <string name="help_import_options_title">Opciones de importación</string>
    <string name="help_import_options_body_1">HistoryLib puede importar directamente sólo el historial de Safari, las exportaciones de Google Takeout y los archivos .hlz.</string>
    <string name="help_import_options_body_2">Para importar el historial desde una computadora o desde más navegadores, use HistoryLib Helper para crear un archivo .hlz y luego importe ese archivo a HistoryLib.</string>
    <string name="help_how_it_works_title">Cómo funciona</string>
    <string name="help_step_1">Descargue y abra HistoryLib Helper en su computadora.</string>
    <string name="help_step_2">Seleccione el historial que desea exportar.</string>
    <string name="help_step_3">Elija si desea proteger el archivo .hlz con una contraseña y luego expórtelo.</string>
    <string name="help_step_4">Transfiera el archivo .hlz a este dispositivo e impórtelo desde Administrar.</string>
    <string name="help_privacy_title">Privacidad</string>
    <string name="help_privacy_body">El asistente se ejecuta localmente, abre bases de datos del historial del navegador en modo de solo lectura y no carga su historial.</string>
    <string name="help_download_helper">Descargar el asistente HistoryLib</string>
