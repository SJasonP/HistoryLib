    <string name="manage_help">Help</string>
    <string name="manage_help_body">Import Safari history, Google Takeout Chrome history, or HistoryLib .hlz archives. Export is user-initiated data transfer, not backup. Site icons may reveal visited domains to their servers.</string>
    <string name="manage_back">Back</string>
    <string name="help_helper_title">HistoryLib Helper</string>
    <string name="help_helper_tagline">Bring browser history into HistoryLib.</string>
    <string name="help_helper_description">HistoryLib Helper is a separate local-only tool for Windows and macOS. It reads supported browser history and exports a .hlz file that HistoryLib can import.</string>
    <string name="help_supported_browsers_title">Supported Browsers</string>
    <string name="help_supported_browsers_body">Google Chrome, Microsoft Edge, Brave, Vivaldi, Opera, Chromium, and Firefox are supported.</string>
    <string name="help_import_options_title">Import Options</string>
    <string name="help_import_options_body_1">HistoryLib can directly import only Safari history, Google Takeout exports, and .hlz archives.</string>
    <string name="help_import_options_body_2">To import history from a computer or from more browsers, use HistoryLib Helper to create a .hlz archive, then import that archive into HistoryLib.</string>
    <string name="help_how_it_works_title">How It Works</string>
    <string name="help_step_1">Download and open HistoryLib Helper on your computer.</string>
    <string name="help_step_2">Select the history you want to export.</string>
    <string name="help_step_3">Choose whether to protect the .hlz file with a password, then export it.</string>
    <string name="help_step_4">Transfer the .hlz file to this device and import it from Manage.</string>
    <string name="help_privacy_title">Privacy</string>
    <string name="help_privacy_body">The Helper runs locally, opens browser history databases read-only, and does not upload your history.</string>
    <string name="help_download_helper">Download HistoryLib Helper</string>
