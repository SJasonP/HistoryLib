    <string name="manage_help">Aide</string>
    <string name="manage_help_body">Importez l’historique Safari, l’historique Google Takeout Chrome ou les archives HistoryLib .hlz. L\'exportation est un transfert de données initié par l\'utilisateur, pas une sauvegarde. Les icônes du site peuvent révéler les domaines visités à leurs serveurs.</string>
    <string name="manage_back">Retour</string>
    <string name="help_helper_title">Aide HistoryLib</string>
    <string name="help_helper_tagline">Apportez l’historique du navigateur dans HistoryLib.</string>
    <string name="help_helper_description">HistoryLib Helper est un outil local distinct pour Windows et macOS. Il lit l\'historique du navigateur pris en charge et exporte un fichier .hlz que HistoryLib peut importer.</string>
    <string name="help_supported_browsers_title">Navigateurs pris en charge</string>
    <string name="help_supported_browsers_body">Google Chrome, Microsoft Edge, Brave, Vivaldi, Opera, Chromium et Firefox sont pris en charge.</string>
    <string name="help_import_options_title">Options d\'importation</string>
    <string name="help_import_options_body_1">HistoryLib ne peut importer directement que l\'historique Safari, les exportations Google Takeout et les archives .hlz.</string>
    <string name="help_import_options_body_2">Pour importer l\'historique depuis un ordinateur ou depuis plusieurs navigateurs, utilisez HistoryLib Helper pour créer une archive .hlz, puis importez cette archive dans HistoryLib.</string>
    <string name="help_how_it_works_title">Comment ça marche</string>
    <string name="help_step_1">Téléchargez et ouvrez HistoryLib Helper sur votre ordinateur.</string>
    <string name="help_step_2">Sélectionnez l\'historique que vous souhaitez exporter.</string>
    <string name="help_step_3">Choisissez si vous souhaitez protéger le fichier .hlz avec un mot de passe, puis exportez-le.</string>
    <string name="help_step_4">Transférez le fichier .hlz sur cet appareil et importez-le depuis Gérer.</string>
    <string name="help_privacy_title">Confidentialité</string>
    <string name="help_privacy_body">L\'assistant s\'exécute localement, ouvre les bases de données d\'historique du navigateur en lecture seule et ne télécharge pas votre historique.</string>
    <string name="help_download_helper">Télécharger l\'aide HistoryLib</string>
