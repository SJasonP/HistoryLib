    "On the Home Screen, touch and hold HistoryLib.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الشاشة الرئيسية، المس HistoryLib مطولاً."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "On the Home Screen, touch and hold HistoryLib."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pantalla de inicio, mantén pulsada HistoryLib."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’écran d’accueil, maintenez HistoryLib appuyée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране «Домой» нажмите и удерживайте HistoryLib."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主屏幕上长按 HistoryLib。"
          }
        }
      }
    },
    "Choose Require Face ID, Touch ID, or Passcode.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر طلب Face ID أو Touch ID أو رمز الدخول."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Require Face ID, Touch ID, or Passcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Requerir Face ID, Touch ID o código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Exiger Face ID, Touch ID ou le code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Требовать Face ID», Touch ID или код-пароль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“要求 Face ID”、“Touch ID”或密码。"
          }
        }
      }
    },
    "Authenticate to lock or unlock the app. HistoryLib does not provide a second in-app lock.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صادق لقفل التطبيق أو إلغاء قفله. لا يوفر HistoryLib قفلاً ثانياً داخل التطبيق."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticate to lock or unlock the app. HistoryLib does not provide a second in-app lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentícate para bloquear o desbloquear la app. HistoryLib no proporciona un segundo bloqueo dentro de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifiez-vous pour verrouiller ou déverrouiller l’app. HistoryLib ne fournit pas de second verrouillage intégré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдите аутентификацию, чтобы заблокировать или разблокировать приложение. HistoryLib не предоставляет дополнительную блокировку внутри приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过认证来锁定或解锁应用。HistoryLib 不会另行提供应用内锁。"
          }
        }
      }
    },
