    "A connection is required. Changes are saved on this device until you are back online." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوب اتصال. يتم حفظ التغييرات على هذا الجهاز حتى تتصل بالإنترنت مرة أخرى."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A connection is required. Changes are saved on this device until you are back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere una conexión. Los cambios se guardan en este dispositivo hasta que vuelva a estar en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une connexion est requise. Les modifications sont enregistrées sur cet appareil jusqu'à ce que vous soyez de nouveau en ligne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется соединение. Изменения сохраняются на этом устройстве, пока вы не вернетесь в Интернет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要网络连接。更改已保存在此设备，联网后将自动同步。"
          }
        }
      }
    },
    "A history record exceeds the safe processing limit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجاوز أحد سجلات التصفح حد المعالجة الآمن."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A history record exceeds the safe processing limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un registro del historial supera el límite de procesamiento seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enregistrement de l’historique dépasse la limite de traitement sûre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись истории превышает безопасный предел обработки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一条历史记录超出了安全处理限制。"
          }
        }
      }
    },
    "A stored timestamp cannot be exported safely." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر تصدير أحد الطوابع الزمنية المخزنة بأمان."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stored timestamp cannot be exported safely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede exportar de forma segura una marca de tiempo almacenada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un horodatage stocké ne peut pas être exporté en toute sécurité."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно безопасно экспортировать сохранённую метку времени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法安全导出一个已存储的时间戳。"
          }
        }
      }
    },
    "Confirm Clear All Data" : {
      "localizations" : {
