    "Your support helps keep HistoryLib open source, ad-free, and free for everyone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يساعد دعمك HistoryLib على البقاء مفتوح المصدر وخاليًا من الإعلانات ومجانيًا للجميع."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your support helps keep HistoryLib open source, ad-free, and free for everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apoyo ayuda a que HistoryLib siga siendo de código abierto, sin anuncios y gratuito para todos."
          }
        },
        "fr" : {
          "stringUnit" : {
