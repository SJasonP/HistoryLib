          }
        }
      }
    },
    "HistoryLib is completely open source, ad-free, and free to use." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib مفتوح المصدر بالكامل وخالٍ من الإعلانات ومجاني الاستخدام."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib is completely open source, ad-free, and free to use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib es completamente de código abierto, sin anuncios y de uso gratuito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib est entièrement open source, sans publicité et gratuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib полностью имеет открытый исходный код, не содержит рекламы и бесплатен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib 完全开源、无广告，并且可以免费使用。"
          }
        }
      }
    },
    "HistoryLib's privacy lock is enabled by default. Open HistoryLib Settings and turn off Require authentication at launch if you do not want it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قفل الخصوصية في HistoryLib مفعّل افتراضيًا. افتح إعدادات HistoryLib وعطّل طلب المصادقة عند التشغيل إذا لم ترده."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib's privacy lock is enabled by default. Open HistoryLib Settings and turn off Require authentication at launch if you do not want it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo de privacidad de HistoryLib está activado de forma predeterminada. Abre los ajustes de HistoryLib y desactiva Requerir autenticación al iniciar si no lo quieres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verrouillage de confidentialité de HistoryLib est activé par défaut. Ouvrez les réglages de HistoryLib et désactivez Exiger une authentification au lancement si vous ne le souhaitez pas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировка конфиденциальности HistoryLib включена по умолчанию. Откройте настройки HistoryLib и отключите требование аутентификации при запуске, если оно не нужно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib 默认启用隐私锁。如果不需要，请打开 HistoryLib 设置并关闭“启动时要求认证”。"
          }
        }
      }
    },
