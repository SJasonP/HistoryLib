    "HistoryLib Helper is a separate local-only tool for Windows and macOS. It reads supported browser history and exports a .hlz file that HistoryLib can import.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HistoryLib Helper 是一款独立且仅在本机运行的 Windows 和 macOS 工具。它可以读取受支持浏览器的历史记录，并导出可由 HistoryLib 导入的 .hlz 文件。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "HistoryLib Helper is a separate local-only tool for Windows and macOS. It reads supported browser history and exports a .hlz file that HistoryLib can import."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "HistoryLib Helper هي أداة محلية منفصلة فقط لنظامي التشغيل Windows وmacOS. يقرأ سجل المتصفح المدعوم ويصدر ملف .hlz الذي يمكن لـ HistoryLib استيراده."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HistoryLib Helper est un outil local distinct pour Windows et macOS. Il lit l'historique du navigateur pris en charge et exporte un fichier .hlz que HistoryLib peut importer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HistoryLib Helper — это отдельный локальный инструмент для Windows и macOS. Он считывает поддерживаемую историю браузера и экспортирует файл .hlz, который HistoryLib может импортировать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HistoryLib Helper es una herramienta local independiente para Windows y macOS. Lee el historial del navegador compatible y exporta un archivo .hlz que HistoryLib puede importar."
          }
        }
      }
    },
