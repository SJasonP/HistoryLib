    "Use HistoryLib Helper to import supported desktop browsers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم HistoryLib Helper لاستيراد متصفحات سطح المكتب المدعومة."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use HistoryLib Helper to import supported desktop browsers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa HistoryLib Helper para importar navegadores de escritorio compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez HistoryLib Helper pour importer les navigateurs de bureau pris en charge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте HistoryLib Helper для импорта поддерживаемых настольных браузеров."
          }
        },
        "zh-Hans": {
