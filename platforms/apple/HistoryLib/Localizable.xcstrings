    "Cloud count is a server snapshot, not sync progress." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد السجلات السحابية لقطة من الخادم، وليس تقدم المزامنة."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud count is a server snapshot, not sync progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recuento en la nube es una instantánea del servidor, no el progreso de sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre dans le cloud est un instantané du serveur, pas la progression de la synchronisation."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
