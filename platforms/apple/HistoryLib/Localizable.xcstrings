    },
    "Use the device or manufacturer App Lock, or Private Space when available.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم قفل التطبيقات في الجهاز أو الشركة المصنّعة أو المساحة الخاصة عند توفرها."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the device or manufacturer App Lock, or Private Space when available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el bloqueo de apps del dispositivo o del fabricante, o Espacio privado cuando esté disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le verrouillage d’apps de l’appareil ou du fabricant, ou l’Espace privé lorsqu’il est disponible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте блокировку приложений устройства или производителя либо личное пространство, если они доступны."
          }
