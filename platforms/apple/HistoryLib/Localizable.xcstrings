    "On-device interpretation is unavailable. You can edit the filters manually.": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device interpretation is unavailable. You can edit the filters manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端解析不可用。你仍可手动编辑筛选条件。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التفسير على الجهاز غير متاح. يمكنك تعديل عوامل التصفية يدويًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interprétation sur l’appareil est indisponible. Vous pouvez modifier les filtres manuellement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание на устройстве недоступно. Вы можете изменить фильтры вручную."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La interpretación en el dispositivo no está disponible. Puedes editar los filtros manualmente."
          }
        }
      }
    },
    "Only your request is processed on this device. History records are not sent to the model.": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your request is processed on this device. History records are not sent to the model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在此设备上处理你的搜索需求，不会向模型发送历史记录。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعالَج طلبك فقط على هذا الجهاز. لا تُرسل سجلات التصفح إلى النموذج."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule votre demande est traitée sur cet appareil. Les historiques ne sont pas envoyés au modèle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве обрабатывается только ваш запрос. Записи истории не передаются модели."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se procesa tu solicitud en este dispositivo. Los registros del historial no se envían al modelo."
          }
        }
      }
    },
