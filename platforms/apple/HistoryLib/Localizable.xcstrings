    "Only .json files, directories, or .zip files are supported." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم دعم ملفات .json أو الدلائل أو ملفات .zip فقط."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only .json files, directories, or .zip files are supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se admiten archivos .json, directorios o archivos .zip."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les fichiers, répertoires ou fichiers .zip .json sont pris en charge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживаются только файлы .json, каталоги или .zip-файлы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅支持 .json 文件、文件夹或 .zip 文件。"
          }
        }
      }
    },
    "Only your request is processed on this device. History records are not sent to the model." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعالَج طلبك فقط على هذا الجهاز. لا تُرسل سجلات التصفح إلى النموذج."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only your request is processed on this device. History records are not sent to the model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se procesa tu solicitud en este dispositivo. Los registros del historial no se envían al modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule votre demande est traitée sur cet appareil. Les historiques ne sont pas envoyés au modèle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве обрабатывается только ваш запрос. Записи истории не передаются модели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在此设备上处理你的搜索需求，不会向模型发送历史记录。"
          }
        }
      }
    },
