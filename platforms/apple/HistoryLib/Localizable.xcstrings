    "Continuing will only clear %@ of cache data and turn off Show Site Icons.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستؤدي المتابعة إلى مسح %@ فقط من بيانات ذاكرة التخزين المؤقت وإيقاف تشغيل \"إظهار أيقونات الموقع\"."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuing will only clear %@ of cache data and turn off Show Site Icons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si continúa, solo se borrarán los datos de la caché de %@ y se desactivará Mostrar iconos del sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer n'effacera que %@ des données du cache et désactivera l'affichage des icônes du site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При продолжении будут удалены только данные кэша %@ и отключено отображение значков сайтов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果继续，只会清理 %@ 的缓存数据并关闭“显示网站图标”。"
          }
        }
      }
    },
