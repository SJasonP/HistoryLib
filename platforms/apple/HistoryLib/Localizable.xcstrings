  },
  "Resume iCloud Sync": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Resume iCloud Sync"
        }
      },
      "en-US": {
        "stringUnit": {
          "state": "translated",
          "value": "Resume iCloud Sync"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "恢复 iCloud 同步"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Reprendre la synchronisation iCloud"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Reanudar la sincronización con iCloud"
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Возобновить синхронизацию iCloud"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "استئناف مزامنة iCloud"
        }
      }
    }
  },
  "Update HistoryLib before resuming iCloud sync.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Update HistoryLib before resuming iCloud sync."
        }
      },
      "en-US": {
        "stringUnit": {
          "state": "translated",
          "value": "Update HistoryLib before resuming iCloud sync."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请先升级 HistoryLib，再恢复 iCloud 同步。"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Mettez HistoryLib à jour avant de reprendre la synchronisation iCloud."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Actualiza HistoryLib antes de reanudar la sincronización con iCloud."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Обновите HistoryLib перед возобновлением синхронизации iCloud."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "حدّث HistoryLib قبل استئناف مزامنة iCloud."
        }
      }
    }
  },
  "Update HistoryLib, or stop iCloud sync and reset this device to use a separate local library.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Update HistoryLib, or stop iCloud sync and reset this device to use a separate local library."
        }
      },
      "en-US": {
        "stringUnit": {
          "state": "translated",
          "value": "Update HistoryLib, or stop iCloud sync and reset this device to use a separate local library."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请升级 HistoryLib，或停止 iCloud 同步并重置本机，以使用独立的本地资料库。"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Mettez HistoryLib à jour, ou arrêtez la synchronisation iCloud et réinitialisez cet appareil pour utiliser une bibliothèque locale distincte."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Actualiza HistoryLib o detén la sincronización con iCloud y restablece este dispositivo para usar una biblioteca local independiente."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Обновите HistoryLib или отключите синхронизацию iCloud и сбросьте это устройство для использования отдельной локальной библиотеки."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "حدّث HistoryLib، أو أوقف مزامنة iCloud وأعد تعيين هذا الجهاز لاستخدام مكتبة محلية منفصلة."
        }
      }
    }
  },
  "After restarting, this device's HistoryLib storage, settings, summaries, and caches will be reset. HistoryLib will use a separate local library with iCloud sync disabled. iCloud history and other devices will not be changed.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "After restarting, this device's HistoryLib storage, settings, summaries, and caches will be reset. HistoryLib will use a separate local library with iCloud sync disabled. iCloud history and other devices will not be changed."
        }
      },
      "en-US": {
        "stringUnit": {
          "state": "translated",
          "value": "After restarting, this device's HistoryLib storage, settings, summaries, and caches will be reset. HistoryLib will use a separate local library with iCloud sync disabled. iCloud history and other devices will not be changed."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "重启后，将重置本机的 HistoryLib 存储、设置、统计和缓存，并使用关闭 iCloud 同步的独立本地资料库。不会修改 iCloud 历史记录或其他设备的数据。"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Après le redémarrage, le stockage, les réglages, les résumés et les caches de HistoryLib seront réinitialisés sur cet appareil. HistoryLib utilisera une bibliothèque locale distincte sans synchronisation iCloud. L’historique iCloud et les autres appareils ne seront pas modifiés."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Tras reiniciar, se restablecerán el almacenamiento, los ajustes, los resúmenes y las cachés de HistoryLib en este dispositivo. Se usará una biblioteca local independiente sin sincronización con iCloud. El historial de iCloud y los otros dispositivos no se modificarán."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "После перезапуска хранилище, настройки, сводки и кеш HistoryLib на этом устройстве будут сброшены. Будет использоваться отдельная локальная библиотека без синхронизации iCloud. История в iCloud и другие устройства не изменятся."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "بعد إعادة التشغيل، ستتم إعادة تعيين تخزين HistoryLib وإعداداته وملخصاته وذاكرته المؤقتة على هذا الجهاز. سيستخدم مكتبة محلية منفصلة مع تعطيل مزامنة iCloud. لن يتغير سجل iCloud أو الأجهزة الأخرى."
        }
      }
    }
  },
  "Restart HistoryLib to finish resetting this device in local-only mode. iCloud and other devices will not be changed.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Restart HistoryLib to finish resetting this device in local-only mode. iCloud and other devices will not be changed."
        }
      },
      "en-US": {
        "stringUnit": {
          "state": "translated",
          "value": "Restart HistoryLib to finish resetting this device in local-only mode. iCloud and other devices will not be changed."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请重启 HistoryLib，完成本机重置并进入仅本地模式。不会修改 iCloud 或其他设备的数据。"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Redémarrez HistoryLib pour terminer la réinitialisation en mode local uniquement. iCloud et les autres appareils ne seront pas modifiés."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Reinicia HistoryLib para completar el restablecimiento en modo solo local. iCloud y los otros dispositivos no se modificarán."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Перезапустите HistoryLib для завершения сброса в локальном режиме. iCloud и другие устройства не изменятся."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "أعد تشغيل HistoryLib لإكمال إعادة تعيين هذا الجهاز في الوضع المحلي فقط. لن يتغير iCloud أو الأجهزة الأخرى."
        }
      }
    }
  },
  "Restart to resume iCloud sync. The separate local library will be kept; export its records first if you want to import them into iCloud.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Restart to resume iCloud sync. The separate local library will be kept; export its records first if you want to import them into iCloud."
        }
      },
      "en-US": {
        "stringUnit": {
          "state": "translated",
          "value": "Restart to resume iCloud sync. The separate local library will be kept; export its records first if you want to import them into iCloud."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "重启后将恢复 iCloud 同步。独立本地资料库会保留；如需将其中的记录导入 iCloud，请先导出这些记录。"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Redémarrez pour reprendre la synchronisation iCloud. La bibliothèque locale distincte sera conservée ; exportez d’abord ses données si vous souhaitez les importer dans iCloud."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Reinicia para reanudar la sincronización con iCloud. Se conservará la biblioteca local independiente; exporta primero sus registros si quieres importarlos a iCloud."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Перезапустите приложение для возобновления синхронизации iCloud. Отдельная локальная библиотека сохранится. Сначала экспортируйте её записи, если хотите импортировать их в iCloud."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "أعد التشغيل لاستئناف مزامنة iCloud. ستُحفظ المكتبة المحلية المنفصلة؛ صدّر سجلاتها أولًا إذا أردت استيرادها إلى iCloud."
        }
      }
    }
  },
    "This resets HistoryLib storage, settings, summaries, and caches on this device only. It does not delete iCloud history or data on other devices. iCloud history may download again after restarting." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيؤدي هذا إلى إعادة تعيين تخزين HistoryLib وإعداداته وملخصاته وذاكرته المؤقتة على هذا الجهاز فقط. لن يُحذف سجل iCloud أو بيانات الأجهزة الأخرى. قد يُنزَّل سجل iCloud مجددًا بعد إعادة التشغيل." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This resets HistoryLib storage, settings, summaries, and caches on this device only. It does not delete iCloud history or data on other devices. iCloud history may download again after restarting." } },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "This resets HistoryLib storage, settings, summaries, and caches on this device only. It does not delete iCloud history or data on other devices. iCloud history may download again after restarting." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esto restablece el almacenamiento, los ajustes, los resúmenes y las cachés de HistoryLib solo en este dispositivo. No elimina el historial de iCloud ni los datos de otros dispositivos. El historial de iCloud puede volver a descargarse tras reiniciar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette opération réinitialise le stockage, les réglages, les résumés et les caches de HistoryLib uniquement sur cet appareil. Elle ne supprime ni l’historique iCloud ni les données des autres appareils. L’historique iCloud pourra être téléchargé à nouveau après le redémarrage." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это сбросит хранилище, настройки, сводки и кеш HistoryLib только на этом устройстве. История в iCloud и данные на других устройствах не будут удалены. После перезапуска история из iCloud может загрузиться снова." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这将仅重置本机的 HistoryLib 存储、设置、统计和缓存，不会删除 iCloud 历史记录或其他设备上的数据。重新启动后，iCloud 历史记录可能会再次同步到本机。" } }
      }
    },
    "Clear Text" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "مسح النص" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear Text" } },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "Clear Text" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Borrar texto" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Effacer le texte" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Очистить текст" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清空文本" } }
      }
    },
