    "The Helper runs locally, opens browser history databases read-only, and does not upload your history.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper 仅在本机运行，以只读方式打开浏览器历史记录数据库，并且不会上传您的历史记录。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The Helper runs locally, opens browser history databases read-only, and does not upload your history."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل المساعد محليًا، ويفتح قواعد بيانات سجل المتصفح للقراءة فقط، ولا يقوم بتحميل السجل الخاص بك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'assistant s'exécute localement, ouvre les bases de données d'historique du navigateur en lecture seule et ne télécharge pas votre historique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощник запускается локально, открывает базы данных истории браузера только для чтения и не загружает вашу историю."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente se ejecuta localmente, abre bases de datos del historial del navegador en modo de solo lectura y no carga su historial."
          }
        }
      }
    },
    "Transfer the .hlz file to this device and import it from Manage.": {
