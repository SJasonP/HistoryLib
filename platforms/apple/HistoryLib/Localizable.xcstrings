    "Sync status is unknown. iCloud sync is managed by the system." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالة المزامنة غير معروفة. تتم إدارة مزامنة iCloud بواسطة النظام."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync status is unknown. iCloud sync is managed by the system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desconoce el estado de sincronización. La sincronización de iCloud la gestiona el sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'état de synchronisation est inconnu. La synchronisation iCloud est gérée par le système."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Статус синхронизации неизвестен. Синхронизация iCloud управляется системой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步状态未知。iCloud 同步由系统管理。"
          }
        }
      }
    },
    "Sync time is the latest successful upload or download observed during this app session. It does not confirm that all devices are up to date." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقت المزامنة هو آخر تحميل أو تنزيل ناجح رُصد خلال جلسة التطبيق الحالية. ولا يؤكد أن جميع الأجهزة محدّثة."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync time is the latest successful upload or download observed during this app session. It does not confirm that all devices are up to date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hora indica la última subida o descarga correcta observada durante esta sesión de la app. No confirma que todos los dispositivos estén actualizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’heure indique le dernier envoi ou téléchargement réussi observé pendant cette session de l’app. Elle ne confirme pas que tous les appareils sont à jour."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время означает последнюю успешную отправку или загрузку, наблюдавшуюся в текущем сеансе приложения. Оно не подтверждает актуальность данных на всех устройствах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步时间表示本次应用运行中观察到的最近一次成功上传或下载，不代表所有设备均已同步完成。"
          }
        }
      }
    },
