  "Stop Sync and Reset This Device": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Stop Sync and Reset This Device"
        }
      },
      "en-US": {
        "stringUnit": {
          "state": "translated",
          "value": "Stop Sync and Reset This Device"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "停止同步并重置本机"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Arrêter la synchronisation et réinitialiser cet appareil"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Detener la sincronización y restablecer este dispositivo"
        }
      },
      "ru": {
        "stringUnit": {
