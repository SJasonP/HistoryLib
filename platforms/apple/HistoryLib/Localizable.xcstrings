    "History storage could not be opened. Changes are paused. Restart the app after resolving the storage problem." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر فتح تخزين السجل. تم إيقاف التغييرات مؤقتًا. أعد تشغيل التطبيق بعد حل مشكلة التخزين."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "History storage could not be opened. Changes are paused. Restart the app after resolving the storage problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir el almacenamiento del historial. Los cambios están en pausa. Reinicia la app después de resolver el problema de almacenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir le stockage de l’historique. Les modifications sont suspendues. Relancez l’app après avoir résolu le problème de stockage."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось открыть хранилище истории. Изменения приостановлены. После устранения проблемы с хранилищем перезапустите приложение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开历史记录存储，已暂停更改。解决存储问题后，请重新启动应用。"
          }
        }
      }
    },
    "History storage unavailable. Changes are paused." : {
      "extractionState" : "manual",
