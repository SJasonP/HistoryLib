    "Open your device's Security or Privacy settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح إعدادات الأمان أو الخصوصية في جهازك."
          }
        },
        "en-US": {
