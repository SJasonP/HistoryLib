    "HistoryLib data was cleared. Please restart the app to continue." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم مسح بيانات HistoryLib. أعد تشغيل التطبيق للمتابعة." } },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "HistoryLib data was cleared. Please restart the app to continue." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se borraron los datos de HistoryLib. Reinicia la app para continuar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les données de HistoryLib ont été effacées. Redémarrez l’app pour continuer." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Данные HistoryLib удалены. Перезапустите приложение, чтобы продолжить." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "HistoryLib 数据已清除。请重启 App 后继续。" } }
      }
    },
    "This will remove HistoryLib history, settings, summaries, and cached data from this device." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيؤدي ذلك إلى إزالة سجل HistoryLib وإعداداته وملخصاته وبياناته المخزنة مؤقتًا من هذا الجهاز." } },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "This will remove HistoryLib history, settings, summaries, and cached data from this device." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esto eliminará del dispositivo el historial, los ajustes, los resúmenes y los datos en caché de HistoryLib." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette action supprimera de cet appareil l’historique, les réglages, les résumés et les données en cache de HistoryLib." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это удалит с устройства историю, настройки, сводки и кэшированные данные HistoryLib." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这会清除此设备上的 HistoryLib 历史记录、设置、摘要和缓存数据。" } }
      }
    },
