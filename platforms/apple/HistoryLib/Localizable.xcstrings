    },
    "HistoryLib can directly import only Safari history, Google Takeout exports, and .hlz archives." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ HistoryLib استيراد سجل Safari وصادرات Google Takeout وأرشيفات ‎.hlz مباشرةً فقط."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib can directly import only Safari history, Google Takeout exports, and .hlz archives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib puede importar directamente sólo el historial de Safari, las exportaciones de Google Takeout y los archivos .hlz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib ne peut importer directement que l'historique Safari, les exportations Google Takeout et les archives .hlz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib может напрямую импортировать только историю Safari, экспорт Google Takeout и архивы .hlz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib 本体仅支持直接导入 Safari 历史记录、Google Takeout 导出文件和 .hlz 归档。"
          }
        }
      }
    },
    "HistoryLib does not add a second app lock on iOS or iPadOS. Use Apple's system Lock App feature instead." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يضيف HistoryLib قفل تطبيق ثانياً على iOS أو iPadOS. استخدم ميزة قفل التطبيقات في Apple بدلاً من ذلك."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib does not add a second app lock on iOS or iPadOS. Use Apple's system Lock App feature instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib no añade un segundo bloqueo en iOS o iPadOS. Usa la función Bloquear apps del sistema de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib n’ajoute pas de second verrouillage sur iOS ou iPadOS. Utilisez plutôt la fonction système de verrouillage des apps d’Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib не добавляет отдельную блокировку на iOS или iPadOS. Используйте системную функцию Apple для блокировки приложений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HistoryLib 不会在 iOS 或 iPadOS 中另行提供应用锁，请改用 Apple 的系统应用锁功能。"
          }
        }
      }
    },
