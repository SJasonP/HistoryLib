    "Windows: HistoryLib's privacy lock is enabled by default. Open Settings and turn off the authentication option if you do not want it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows: قفل الخصوصية في HistoryLib مفعّل افتراضياً. افتح الإعدادات وعطّل خيار المصادقة إذا لم ترده."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows: HistoryLib's privacy lock is enabled by default. Open Settings and turn off the authentication option if you do not want it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows: el bloqueo de privacidad de HistoryLib está activado de forma predeterminada. Abre Ajustes y desactiva la opción de autenticación si no lo quieres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows : le verrouillage de confidentialité de HistoryLib est activé par défaut. Ouvrez les paramètres et désactivez l’option d’authentification si vous ne le souhaitez pas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows: блокировка конфиденциальности HistoryLib включена по умолчанию. Откройте настройки и отключите аутентификацию, если она не нужна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows：HistoryLib 默认启用隐私锁。如不需要，请打开设置并关闭认证选项。"
          }
        }
      }
    },
